//@version=6
indicator("Cumulative Volume Delta + Divergences (Fuzzy Pivots)", "CVD+Div", format=format.volume, max_lines_count=500, max_labels_count=500)

import TradingView/ta/8

// —— Inputs
anchorInput = input.timeframe("1D", "Anchor period")
useCustomTimeframeInput = input.bool(false, "Use custom timeframe")
lowerTimeframeInput = input.timeframe("1", "Timeframe", active = useCustomTimeframeInput)

// —— Visualization settings
lineColor = input.color(color.new(#b9bdbd, 0), "Line color")
lineWidth = input.int(2, "Line width", minval = 1, maxval = 5)
barDivOn = input.bool(true, "Show absorption dots above CVD bars")
dotColorBuy = input.color(#1cc3064d, "Buy absorption dot color (🟢)")
dotColorSell = input.color(color.new(#ab0404, 0), "Sell absorption dot color (🔴)")

// —— Pivot tolerance (% deviation allowed between consecutive pivots)
pivotTolerance = input.float(0.002, "Pivot height tolerance (%)", minval = 0.0, step = 0.001)

// —— Automatic lower timeframe selection
var lowerTimeframe = switch
    useCustomTimeframeInput => lowerTimeframeInput
    timeframe.isseconds => "1S"
    timeframe.isintraday => "1"
    timeframe.isdaily => "5"
    => "60"

// —— CVD data
[openVolume, maxVolume, minVolume, lastVolume] = ta.requestVolumeDelta(lowerTimeframe, anchorInput)
deltaBar = lastVolume - openVolume

// —— Absorption logic
isGreenCandle = close > open
isRedCandle = close < open
isRedDelta = deltaBar < 0
isGreenDelta = deltaBar > 0
buyAbsorption = barDivOn and isGreenCandle and isRedDelta
sellAbsorption = barDivOn and isRedCandle and isGreenDelta

// —— CVD candle color
barColor = lastVolume >= openVolume ? #4caf50 : #673ab7

// —— Drawing
hline(0)
plotcandle(openVolume, maxVolume, minVolume, lastVolume, title="CVD", color=barColor, bordercolor=barColor, wickcolor=barColor)

if buyAbsorption
    label.new(bar_index, maxVolume, "•", style=label.style_none, textcolor=dotColorBuy, size=size.normal)
if sellAbsorption
    label.new(bar_index, maxVolume, "•", style=label.style_none, textcolor=dotColorSell, size=size.normal)

// —— Volume availability check
var float cumVol = 0.0
cumVol += nz(volume)
if barstate.islast and cumVol == 0
    runtime.error("The data vendor doesn't provide volume data for this symbol.")

// —— Divergence settings
divsOn = input.bool(true, "Draw divergences")
useDelta = input.string("CVD (last)", "Div source", options = ["CVD (last)", "Delta (last - open)"])
pivotLen = input.int(2, "Pivot left/right", minval = 2)
cvd = lastVolume
osc = useDelta == "Delta (last - open)" ? deltaBar : cvd

// —— Pivot points
phOsc = ta.pivothigh(osc, pivotLen, pivotLen)
plOsc = ta.pivotlow(osc, pivotLen, pivotLen)
phPrice = ta.pivothigh(close, pivotLen, pivotLen)
plPrice = ta.pivotlow(close, pivotLen, pivotLen)

// —— Confirmed pivots (with delay)
confirmedPhOsc   = phOsc
confirmedPhPrice = phPrice
confirmedPhBar   = bar_index - pivotLen
confirmedPhAnchor = time(anchorInput)[pivotLen]

confirmedPlOsc   = plOsc
confirmedPlPrice = plPrice
confirmedPlBar   = bar_index - pivotLen
confirmedPlAnchor = time(anchorInput)[pivotLen]

// —— Memory of previous pivots
var float prevPhOsc = na
var float prevPhPrice = na
var int prevPhBar = na
var int prevPhAnchor = na

var float prevPlOsc = na
var float prevPlPrice = na
var int prevPlBar = na
var int prevPlAnchor = na

// —— Drawing helpers
drawAbsorption(fromBar, fromY, toBar, toY) =>
    line.new(fromBar, fromY, toBar, toY, extend=extend.none, color=lineColor, width=lineWidth, style=line.style_solid)

drawExhaustion(fromBar, fromY, toBar, toY) =>
    line.new(fromBar, fromY, toBar, toY, extend=extend.none, color=lineColor, width=lineWidth, style=line.style_dashed)

// —— Alert flags
var bool exhaustionTrig = false
var bool absorptionTrig = false
exhaustionTrig := false
absorptionTrig := false

// —— Divergence logic (HIGH)
if divsOn and not na(confirmedPhOsc) and not na(confirmedPhPrice)
    sameAnchorHigh = confirmedPhAnchor == prevPhAnchor
    if not na(prevPhOsc) and sameAnchorHigh
        isBearishRegular = confirmedPhPrice > prevPhPrice * (1 - pivotTolerance) and confirmedPhOsc < prevPhOsc
        isHiddenBearish  = confirmedPhPrice < prevPhPrice * (1 + pivotTolerance) and confirmedPhOsc > prevPhOsc
        if isBearishRegular
            drawExhaustion(prevPhBar, prevPhOsc, confirmedPhBar, confirmedPhOsc)
            exhaustionTrig := true
        if isHiddenBearish
            drawAbsorption(prevPhBar, prevPhOsc, confirmedPhBar, confirmedPhOsc)
            absorptionTrig := true
    prevPhOsc := confirmedPhOsc
    prevPhPrice := confirmedPhPrice
    prevPhBar := confirmedPhBar
    prevPhAnchor := confirmedPhAnchor

// —— Divergence logic (LOW)
if divsOn and not na(confirmedPlOsc) and not na(confirmedPlPrice)
    sameAnchorLow = confirmedPlAnchor == prevPlAnchor
    if not na(prevPlOsc) and sameAnchorLow
        isBullishRegular = confirmedPlPrice < prevPlPrice * (1 + pivotTolerance) and confirmedPlOsc > prevPlOsc
        isHiddenBullish  = confirmedPlPrice > prevPlPrice * (1 - pivotTolerance) and confirmedPlOsc < prevPlOsc
        if isBullishRegular
            drawExhaustion(prevPlBar, prevPlOsc, confirmedPlBar, confirmedPlOsc)
            exhaustionTrig := true
        if isHiddenBullish
            drawAbsorption(prevPlBar, prevPlOsc, confirmedPlBar, confirmedPlOsc)
            absorptionTrig := true
    prevPlOsc := confirmedPlOsc
    prevPlPrice := confirmedPlPrice
    prevPlBar := confirmedPlBar
    prevPlAnchor := confirmedPlAnchor

// —— Alerts
alertcondition(exhaustionTrig, "Exhaustion", "CVD/Delta: exhaustion (regular divergence)")
alertcondition(absorptionTrig, "Absorption", "CVD/Delta: absorption (hidden divergence)")
alertcondition(buyAbsorption, "Buy Absorption", "Green candle but red delta (buy absorption)")
alertcondition(sellAbsorption, "Sell Absorption", "Red candle but green delta (sell absorption)")
